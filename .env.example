# Copy to .env. Never commit .env; it is gitignored.

# Migrations run as the table owner.
DATABASE_URL="postgresql://bailey_owner:bailey_local_dev@127.0.0.1:5433/bailey?schema=public"

# The application connects as a restricted role that cannot bypass row-level
# security. This separation is the whole point -- see docs/adr/0001.
APP_DATABASE_URL="postgresql://bailey_app:bailey_local_dev@127.0.0.1:5433/bailey?schema=public"

REDIS_URL="redis://127.0.0.1:6380"

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Origin the app is served from, used for absolute links in invitation emails.
APP_ORIGIN="http://localhost:3000"
